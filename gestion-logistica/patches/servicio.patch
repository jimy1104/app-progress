+def _mapa_paginas(doc, segs):
+    """Qué es cada hoja: a qué documento pertenece (índice en «documentos»),
+    si es su primera hoja y si es un reverso en blanco."""
+    out = []
+    for n in range(1, doc.n_pages + 1):
+        idx = next((i for i, s in enumerate(segs) if s.pagina_ini <= n <= s.pagina_fin), -1)
+        if idx < 0:
+            # reversos en blanco que quedaron fuera del corte: van con el documento anterior
+            idx = max((i for i, s in enumerate(segs) if s.pagina_fin < n), default=-1)
+        try:
+            blanco = segmentador._pagina_vacia(doc.pages[n - 1])
+        except Exception:
+            blanco = False
+        out.append({"p": n, "doc": idx, "primera": any(s.pagina_ini == n for s in segs), "blanco": blanco})
+    return out
+
