<?xml version="1.0" encoding="utf-8"?>
<!-- Used only if the App Service runs on Windows (IIS serves the static files directly). -->
<configuration>
  <system.webServer>
    <defaultDocument>
      <files><clear /><add value="index.html" /></files>
    </defaultDocument>
    <staticContent>
      <remove fileExtension=".json" /><mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".srt" /><mimeMap fileExtension=".srt" mimeType="text/plain" />
      <remove fileExtension=".vtt" /><mimeMap fileExtension=".vtt" mimeType="text/vtt" />
      <remove fileExtension=".ass" /><mimeMap fileExtension=".ass" mimeType="text/plain" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <add name="Permissions-Policy" value="microphone=(self), autoplay=(self), fullscreen=(self)" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
